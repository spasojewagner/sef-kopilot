# Normalise line endings: every text file is stored with LF and checked out with LF,
# on every platform (Windows included), so hooks, linters and diffs behave identically.
* text=auto eol=lf

# Shell scripts must stay LF even if a Windows editor touches them.
*.sh text eol=lf

# Binary assets: never normalised, never diffed as text.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.woff binary
*.woff2 binary
*.pdf binary
*.zip binary
*.gz binary
*.p12 binary
*.pfx binary

# Official example documents are kept byte for byte (their SHA-256 is pinned in a manifest),
# so their line endings are never normalised.
fixtures/invoices/official/**/*.xml -text

# Generated lock files: collapsed in GitHub diffs, never hand-edited.
uv.lock linguist-generated=true
pnpm-lock.yaml linguist-generated=true
