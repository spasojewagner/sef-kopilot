# The web application's settings. Next.js reads them from this directory, not from the
# repository's root: copy this file to `.env.local` to change one. A NEXT_PUBLIC_ variable is
# written into the code the browser loads when the application is built, so it is public.

# Where the browser sends its requests to the API; http://127.0.0.1:8000 when it is not set.
# The page's origin, http://localhost:3000 locally, must be one of the API's SEF_WEB_ORIGINS.
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
