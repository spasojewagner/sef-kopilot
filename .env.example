# Copy this file to `.env` and fill in what you need. `.env` is git-ignored and must never be
# committed; this example contains variable names and local-only defaults, never real secrets.
# Variables marked (M2+) are read from milestone 2 on and can stay empty until then.

# --- Local infrastructure (infra/docker-compose.yml) -------------------------------------
POSTGRES_USER=sef
POSTGRES_PASSWORD=sef
POSTGRES_DB=sef_kopilot
POSTGRES_PORT=5432
REDIS_PORT=6379

# --- API (M2+) ----------------------------------------------------------------------------
SEF_ENVIRONMENT=development
DATABASE_URL=postgresql+asyncpg://sef:sef@localhost:5432/sef_kopilot
# API tests: a PostgreSQL server on which the suite creates and drops its own databases (the
# user needs CREATEDB), e.g. postgresql+asyncpg://sef:sef@localhost:5432/postgres for the one
# `make up` starts. Left empty, the database tests are skipped. The end-to-end test (`make e2e`)
# makes its own database, sef_e2e, there anew each time it runs.
SEF_TEST_DATABASE_URL=
# Worker tests: a Redis server whose database the suite empties, e.g. redis://localhost:6379/15
# for the one `make up` starts. Left empty, the worker tests are skipped.
SEF_TEST_REDIS_URL=
# Where jobs run (optional): inline (default), in the API's own process, for a deployment of
# one process; or arq, in workers (`make worker`) that take them from the queue at REDIS_URL.
SEF_JOBS=inline
REDIS_URL=redis://localhost:6379/0
# Days a finished job is kept before it is deleted; a job under way is never deleted.
SEF_JOB_RETENTION_DAYS=30
# Signs access tokens; at least 32 characters, required in production. Left empty elsewhere, a
# random key is made for each process (tokens do not survive a restart). Generate one with
#                       python -c "import secrets; print(secrets.token_urlsafe(48))"
SEF_JWT_SECRET=
# Token lifetimes (optional): access tokens 1-60 minutes, refresh tokens 1-90 days.
SEF_ACCESS_TOKEN_MINUTES=15
SEF_REFRESH_TOKEN_DAYS=30
# The largest invoice the API accepts (optional): 1024 to 10485760 bytes, 5 MiB by default.
SEF_MAX_INVOICE_BYTES=5242880
# The most elements an invoice may have (optional): 100 to 1000000, 20000 by default.
SEF_MAX_INVOICE_ELEMENTS=20000
# The longest request body other than an invoice (optional): 65536 to 16777216 bytes, 1 MiB
# by default; it bounds the JSON of a request, such as a list of patches.
SEF_MAX_BODY_BYTES=1048576
# Seconds a client has to send an invoice, and one validation may take (optional).
SEF_UPLOAD_SECONDS=30
SEF_VALIDATION_SECONDS=15
# Validations that may wait or run at once before the next is turned away (optional).
SEF_MAX_VALIDATIONS_IN_FLIGHT=8
# Validations a minute, storing included, for one caller (a person or an API key) and for all
# the callers of one organization, before the next answers 429 (optional).
SEF_VALIDATIONS_PER_MINUTE=60
SEF_ORGANIZATION_VALIDATIONS_PER_MINUTE=300
# Where invoices are validated (optional): process (default) or thread, for tests and tools.
SEF_VALIDATOR=process
# What one organization may store, invoices and their reports together, in bytes (optional).
SEF_MAX_STORED_BYTES=104857600
# The origins of the web application, separated by commas, whose pages may call the API
# (CORS); none when empty. In production each is https://, such as https://sef-kopilot.pages.dev.
SEF_WEB_ORIGINS=http://localhost:3000
# Whether this server is a public demonstration, where no real invoice belongs (`GET /health`
# says so, and the web application asks for synthetic invoices only on its upload).
SEF_PUBLIC_DEMO=false
# The API's own origin, as its clients reach it (optional; https:// in production), such as
# https://sef-kopilot-api.onrender.com: the issuer of the MCP endpoint's OAuth 2.1 authorization
# server, under /oauth. Without it those routes answer 404, and /mcp takes API keys alone.
SEF_PUBLIC_URL=
# The web application's origin, one of SEF_WEB_ORIGINS, whose page lets a signed-in person
# decide what an MCP client may do for them (optional). Without it /oauth/authorize answers 503.
SEF_WEB_URL=
# true lets an MCP client be known by an https client_id whose metadata document the
# authorization server fetches at each authorization, from a public address only (optional;
# ADR-0045). Off by default: a self-hosted deployment calls out to nothing it did not choose.
SEF_CLIENT_METADATA_DOCUMENTS=false
# Encrypts tenant SEF API keys at rest (Fernet):
#                       python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SEF_FERNET_KEY=

# --- Language model and embeddings, bring your own key (M2+) -------------------------------
# The model that writes explanations and proposes repairs (optional): none (default), and
# POST /invoices/explain and POST /invoices/{id}/repairs/suggestion answer 503; or groq,
# Groq's API, with GROQ_API_KEY (a free key: console.groq.com).
LLM_PROVIDER=none
GROQ_API_KEY=
# The provider's model, when not its default (openai/gpt-oss-120b on Groq) (optional).
SEF_LLM_MODEL=
# The most rules of one report explained in one request, and the seconds they may take
# together (optional).
SEF_MAX_EXPLANATIONS=5
SEF_EXPLANATION_SECONDS=30
# The seconds the model's rounds of patches for one repair may take together (optional).
SEF_REPAIR_SECONDS=20
# Requests to the model a minute, for explanations or a repair, for one caller and for all
# the callers of one organization, before the next answers 429 (optional).
SEF_EXPLANATIONS_PER_MINUTE=10
SEF_ORGANIZATION_EXPLANATIONS_PER_MINUTE=30
# Planned providers (not read yet).
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Who embeds the corpus when `make ingest` loads it (optional): none (default), and passages are
# found by their keywords alone; or jina, Jina's embeddings API, with JINA_API_KEY.
EMBEDDINGS_PROVIDER=none
JINA_API_KEY=

# --- Observability (M2+) ------------------------------------------------------------------
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
# The DSN of the Sentry project that unexpected errors are reported to, without what a person
# sent (optional, ADR-0048); none sends nothing anywhere.
SENTRY_DSN=

# --- SEF demo environment (M5) ------------------------------------------------------------
SEF_DEMO_BASE_URL=https://demoefaktura.mfin.gov.rs

# --- Billing, Stripe sandbox only (M6) ----------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Web app ------------------------------------------------------------------------------
# Next.js reads the web application's settings from apps/web, not from here: see
# apps/web/.env.example (NEXT_PUBLIC_API_URL).
