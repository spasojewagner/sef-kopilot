# ---------------------------------------------------------------------------
# Secrets and local configuration — never committed
# ---------------------------------------------------------------------------
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
*.crt
*.cer
*.jks
secrets/

# ---------------------------------------------------------------------------
# Data that must never enter the repository (real invoices, databases, dumps)
# ---------------------------------------------------------------------------
*.db
*.sqlite
*.sqlite3
*.dump
*.sql.gz
/data/
/uploads/
/tmp/
/corpus/raw/

# Fetched third-party rule sets live outside version control (see third_party/README.md)
/third_party/*
!/third_party/README.md
!/third_party/manifest.json

# Session handoff notes for the maintainer (PR drafts) are local only
/.handoff/

# ---------------------------------------------------------------------------
# Python
# ---------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.venv/
venv/
env/
.python-version.local
*.egg-info/
.eggs/
dist/
build/
wheels/
pip-wheel-metadata/
.installed.cfg
.mypy_cache/
.ruff_cache/
.pytest_cache/
.hypothesis/
.coverage
.coverage.*
coverage.xml
htmlcov/
.cache/

# ---------------------------------------------------------------------------
# Node / Next.js
# ---------------------------------------------------------------------------
node_modules/
.pnpm-store/
.next/
out/
.turbo/
*.tsbuildinfo
next-env.d.ts
coverage/
.vercel
.eslintcache
test-results/
playwright-report/
playwright/.cache/

# ---------------------------------------------------------------------------
# Editors and operating systems
# ---------------------------------------------------------------------------
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
*.swp
*.swo
*~
.DS_Store
Thumbs.db
desktop.ini

# ---------------------------------------------------------------------------
# Logs and temporary files
# ---------------------------------------------------------------------------
*.log
logs/
*.tmp
*.bak
*.orig
