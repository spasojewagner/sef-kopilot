"""Type information for the part of pypdfium2 that the API's extraction uses.

pypdfium2 ships no type hints or ``py.typed`` marker. These declarations follow its API
reference (version 5) and cover only the calls made by ``sef_api.extraction.documents``;
extend them when more of the API is used.
"""

from collections.abc import Iterator

from PIL import Image

class PdfiumError(RuntimeError): ...

class PdfBitmap:
    def to_pil(self) -> Image.Image: ...

class PdfTextPage:
    def get_text_bounded(self) -> str: ...

class PdfPage:
    def get_size(self) -> tuple[float, float]: ...
    def render(self, *, scale: float = ...) -> PdfBitmap: ...
    def get_textpage(self) -> PdfTextPage: ...
    def close(self) -> None: ...

class PdfDocument:
    def __init__(self, input: bytes, password: str | None = ...) -> None: ...  # noqa: A002
    def __len__(self) -> int: ...
    def __iter__(self) -> Iterator[PdfPage]: ...
    def __getitem__(self, index: int) -> PdfPage: ...
    def close(self) -> None: ...
