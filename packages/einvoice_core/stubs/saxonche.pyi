"""Type information for the part of saxonche (SaxonC-HE) that einvoice_core uses.

saxonche is a compiled extension without type hints or a ``py.typed`` marker. These
declarations follow the SaxonC 13 Python API reference and cover only the calls made by
``einvoice_core.schematron``; extend them when the package starts using more of the API.
"""

class PySaxonApiError(Exception): ...
class PyXdmValue: ...
class PyXdmItem(PyXdmValue): ...
class PyXdmNode(PyXdmItem): ...
class PyXdmAtomicValue(PyXdmItem): ...

class PyXsltExecutable:
    def set_parameter(self, name: str, value: PyXdmValue) -> None: ...
    def set_global_context_item(self, *, xdm_item: PyXdmItem) -> None: ...
    def transform_to_string(
        self, *, source_file: str = ..., xdm_node: PyXdmNode = ..., base_output_uri: str = ...
    ) -> str | None: ...

class PyXslt30Processor:
    def compile_stylesheet(
        self, *, stylesheet_file: str = ..., stylesheet_text: str = ...
    ) -> PyXsltExecutable: ...

class PySaxonProcessor:
    def __init__(self, *, license: bool = ...) -> None: ...  # noqa: A002 - saxonche's keyword
    def new_xslt30_processor(self) -> PyXslt30Processor: ...
    def parse_xml(self, *, xml_text: str = ..., encoding: str = ...) -> PyXdmNode: ...
    def make_string_value(self, value: str) -> PyXdmAtomicValue: ...
